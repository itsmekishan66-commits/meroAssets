# Client-side environment variables
# NOTE: Vite only exposes variables prefixed with VITE_ to the app (import.meta.env).
# The dev server proxies /api to the backend — see vite.config.js.

# MongoDB connection string — used by the backend (see server/.env)
MONGODB_URI=mongodb://localhost:27017/meroAssets

# Backend port — used by the backend (see server/.env)
PORT=5000
